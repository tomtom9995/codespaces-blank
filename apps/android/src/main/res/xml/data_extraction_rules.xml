<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Sitzungsdaten in Backups oder Gerätetransfer: Anmeldung ist an dieses Gerät gebunden. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
