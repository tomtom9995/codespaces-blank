# ── Lokale Entwicklung: https://*.chattia.internal:8443 (Caddy stellt lokale Zertifikate aus) ──
# Einmalig in /etc/hosts (macOS/Linux) bzw. C:\Windows\System32\drivers\etc\hosts eintragen:
#   127.0.0.1 auth.chattia.internal cloud.chattia.internal www.chattia.internal api.chattia.internal
# (Nicht *.localhost: curl/PHP leiten das immer auf den eigenen Container um, Nextcloud fände Keycloak nicht.)
# Danach einmalig ./dev-trust.sh ausführen, damit Nextcloud & Co. der lokalen Zertifizierungsstelle vertrauen.
# Produktion: HTTPS_PORT=443, Sites/URLs mit echten Domains (z. B. cloud.example.org) – Let's Encrypt automatisch.
HTTP_PORT=8081
HTTPS_PORT=8443
AUTH_HOST=auth.chattia.internal
CLOUD_HOST=cloud.chattia.internal
WEB_HOST=www.chattia.internal
API_HOST=api.chattia.internal
AUTH_SITE=https://auth.chattia.internal:8443
CLOUD_SITE=https://cloud.chattia.internal:8443
WEB_SITE=https://www.chattia.internal:8443
API_SITE=https://api.chattia.internal:8443
AUTH_URL=https://auth.chattia.internal:8443
CLOUD_URL=https://cloud.chattia.internal:8443
WEB_URL=https://www.chattia.internal:8443
API_URL=https://api.chattia.internal:8443
CLOUD_SCHEME=https
CLOUD_HOST_WITH_PORT=cloud.chattia.internal:8443
WORDPRESS_ALLOW_INTERNAL_IDP=1
NOVA_UPSTREAM=host.docker.internal:8080

# ── Geheimnisse (in Produktion aus dem Secret Manager, z. B. per `gcloud secrets versions access`) ──
POSTGRES_ROOT_PASSWORD=dev-postgres
KEYCLOAK_DB_PASSWORD=dev-keycloak
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=dev-kc-admin
NEXTCLOUD_DB_PASSWORD=dev-nextcloud
NEXTCLOUD_ADMIN_USER=nc-admin
NEXTCLOUD_ADMIN_PASSWORD=dev-nc-admin-2026
NEXTCLOUD_OIDC_SECRET=dev-nextcloud-oidc-secret
WORDPRESS_OIDC_SECRET=dev-wordpress-oidc-secret
NOVA_OIDC_SECRET=dev-nova-oidc-secret
MARIADB_ROOT_PASSWORD=dev-mariadb
WORDPRESS_DB_PASSWORD=dev-wordpress
WORDPRESS_ADMIN_EMAIL=webmaster@example.org
# Öffentlicher Abo-Link des Semesterprogramms (docker compose exec nextcloud bash /chattia/semesterprogramm.sh)
WORDPRESS_EVENTS_ICS=

# Weitere Nextcloud-Apps (Leerzeichen-getrennt). groupfolders wird für die Team-Ordner (nextcloud/teamfolders.conf) gebraucht.
NEXTCLOUD_EXTRA_APPS=groupfolders calendar contacts deck polls

# ── Backup (restic) ─────────────────────────────────────────────────────────────────────
# Lokal: Verzeichnis-Repository. Produktion: gs:chattia-backup-primary:/restic (siehe docs/plan/backup.md)
RESTIC_REPOSITORY=/repo
RESTIC_PASSWORD=dev-restic-passwort
RESTIC_LOCAL_REPO_DIR=./backup-repo
BACKUP_HEALTHCHECK_URL=
# Produktion: 0 (Löschen nur durch den Wartungsjob mit eigenem Dienstkonto)
BACKUP_FORGET_ENABLED=1
# Zweite Kopie bei anderem Anbieter, z. B. s3:https://s3.eu-central-003.backblazeb2.com/chattia-offsite oder sftp:…
OFFSITE_REPOSITORY=
OFFSITE_PASSWORD=
# Jahresarchiv: öffentlicher age-Schlüssel (age1…), Ordner relativ zum Nextcloud-Datenordner, Ziel-Bucket mit Bucket Lock
ARCHIVE_AGE_RECIPIENT=
ARCHIVE_PATHS=
ARCHIVE_BUCKET=
