# Kopieren nach .env und ausfüllen. .env niemals committen.

# KI-Modell (eins von beiden; ohne Angabe läuft der Testmodus)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI-kompatibles Gateway, z. B. LiteLLM vor Vertex AI/Gemini
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=

# Anmelden mit Google/Apple: OAuth-Client-IDs (kommagetrennt)
GOOGLE_CLIENT_IDS=

# Zentraler Login (Chattia-Konto, Keycloak aus infra/hosting) und Dateien aus Nextcloud – leer = aus
# z. B. OIDC_ISSUER=https://auth.chattia.internal:8443/realms/chattia, OIDC_CLIENT_SECRET=dev-nova-oidc-secret,
#      NEXTCLOUD_URL=https://cloud.chattia.internal:8443, PUBLIC_BASE_URL=https://api.chattia.internal:8443
OIDC_ISSUER=
OIDC_CLIENT_SECRET=
NEXTCLOUD_URL=
# Chattia-Assistent: Ordner in der Cloud, aus denen Wissen gelesen wird (Komma-getrennt, Standard: alles Sichtbare "/")
# KNOWLEDGE_FOLDERS=/Corps,/Semesterprogramm,/Haus
# Größte Datei für Uploads aus der App (MB)
# MAX_UPLOAD_MB=512
APPLE_CLIENT_IDS=

# Strapi-Admin (nur lokal automatisch angelegt)
STRAPI_ADMIN_EMAIL=admin@example.com
STRAPI_ADMIN_PASSWORD=NovaAdmin2026!
