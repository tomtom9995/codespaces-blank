# Kopieren nach .env und ausfüllen. .env niemals committen.

# KI-Modell (eins von beiden; ohne Angabe läuft der Testmodus)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI-kompatibles Gateway, z. B. LiteLLM vor Vertex AI/Gemini
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=

# Anmelden mit Google/Apple: OAuth-Client-IDs (kommagetrennt)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Strapi-Admin (nur lokal automatisch angelegt)
STRAPI_ADMIN_EMAIL=admin@example.com
STRAPI_ADMIN_PASSWORD=NovaAdmin2026!
