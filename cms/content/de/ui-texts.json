  {"key": "security.blocked.title", "category": "security", "text": "Anmeldung vorsorglich gestoppt"},
  {"key": "security.blocked.body", "category": "security", "text": "Diese Anmeldung wirkt ungewöhnlich. Zu deinem Schutz haben wir sie gestoppt und dich per E-Mail informiert. Versuch es auf einem Gerät, das du schon benutzt hast, oder starte die Kontowiederherstellung."},
  {"key": "security.waitingPeriod.body", "category": "security", "text": "Zu deinem Schutz wird diese Änderung erst am {effectiveDate} wirksam. Bis dahin kannst du sie jederzeit abbrechen.", "placeholders": ["effectiveDate"]},
